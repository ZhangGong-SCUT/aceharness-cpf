# AIWeb 环境变量配置模板
# 使用方法：复制为 .env 并填入真实值（.env 不会被提交到 git）

# ─── AceHarness 工作流服务 ───
ACEHARNESS_BASE_URL=https://cpf-manager.xyz
ACEHARNESS_EMAIL=your_email@example.com
ACEHARNESS_PASSWORD=your_password
ACEHARNESS_CONFIG_FILE=flutter-ohos-diagnosis.yaml

# ─── GitCode API Token ───
GITCODE_TOKEN=your_gitcode_token

# ─── 数据库管理服务 ───
# 设置为至少 32 字节随机值；启动 dbController 时也必须注入此变量
DB_CONTROLLER_TOKEN=replace_with_at_least_32_random_bytes

# ─── Web 反向代理 ───
# 仅当 Web 服务位于可信反向代理之后时配置为实际代理跳数；直连保持 0
TRUST_PROXY_HOPS=0
